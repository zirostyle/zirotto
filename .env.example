# ============================================================
# 자격증명 (필수)
# ============================================================
USER_ID=your_id
PASSWD=your_password
# 예치금 충전 시 사용하는 6자리 PIN
CHARGE_PIN=123456


# ============================================================
# 로또 6/45 설정
# ============================================================
# 6/45 구매 활성화 (0 = 비활성)
ENABLE_LOTTO645=1

# 이 날짜(KST, YYYY-MM-DD) 이전에는 6/45 를 구매하지 않습니다.
# 비워두면 항상 구매합니다.
LOTTO645_ENABLE_FROM=

# --- 번호 선택 방식 (셋을 조합해도 되며, 합계는 최대 5게임) ---

# 1) 기댓값 최적화 전략 번호 게임 수 (권장)
#    당첨 '확률'은 올라가지 않습니다 (1등 1/8,145,060 고정).
#    다수가 선호하는 조합(생일 1~31, 연속수, 격자 패턴 등)을 회피해
#    1~3등 당첨 시 분배 인원을 줄여 기대 수령액을 높입니다.
STRATEGY_GAMES=5

# 전략 번호 재현이 필요할 때만 시드를 지정하세요. (비워두면 매번 랜덤)
STRATEGY_SEED=

# 2) 사이트 자동 선택 게임 수
AUTO_GAMES=0

# 3) 직접 지정 번호 (JSON, 각 6개 / 1~45 / 중복 없음)
MANUAL_NUMBERS=[]


# ============================================================
# 연금복권 720+ 설정
# ============================================================
ENABLE_LOTTO720=1
# 5,000원 단위여야 합니다 (5000, 10000, 15000, ...)
LOTTO720_AMOUNT=5000


# ============================================================
# 예치금 충전 설정
# ============================================================
# 1회 충전 금액. 사이트 드롭다운 제약으로 5000 / 10000 / 20000 만 가능합니다.
CHARGE_AMOUNT=10000

# 구매 후 남겨둘 최소 잔액 기준 (필요 금액이 이보다 작아도 이 금액까지는 확보)
MIN_BALANCE_FLOOR=10000


# ============================================================
# 텔레그램 알림 (선택)
# ============================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here


# ============================================================
# 운영 플래그
# ============================================================
# 1 이면 실제 구매/충전을 하지 않고 직전 단계까지만 실행합니다.
DRY_RUN=0

# 1 이면 스크린샷/HTML 을 debug/ 에 저장합니다.
# 주의: 계정 정보와 잔액이 포함되므로 커밋하지 마세요. (.gitignore 처리됨)
DEBUG=0

# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
